{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "esnext",
    "skipLibCheck": true
  },
  "include": ["App.js", "index.js", "src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
